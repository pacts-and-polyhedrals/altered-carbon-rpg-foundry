          <details class="ac-disclosure-record ac-trait-record"><summary><span class="ac-data-icon"><i class="fa-solid fa-diagram-project"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>{{system.tree}} / {{system.branch}} · Tier {{system.tier}} · {{#if numericMapped}}AUTOMATED COMPONENTS{{else}}GM-ASSISTED EFFECTS{{/if}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
            <div class="ac-record-facts four"><div><span>Trait Tree</span><strong>{{system.tree}}</strong></div><div><span>Branch</span><strong>{{system.branch}}</strong></div><div><span>Tier</span><strong>{{system.tier}}</strong></div><div><span>Commonality</span><strong>{{system.commonality}}</strong></div><div><span>SP Cost</span><strong>{{system.spCost}}</strong></div></div>
            {{#if system.effect}}<div class="ac-record-block"><span>Mechanical Effect</span><div>{{{system.effect}}}</div></div>{{/if}}{{#if system.trigger}}<div class="ac-record-block"><span>Trigger / Note</span><div>{{{system.trigger}}}</div></div>{{/if}}
            <div class="ac-record-actions"><button type="button" data-action="askTraitGM" data-item-id="{{id}}" title="Send a private GM chat card requesting review of this Trait"><i class="fa-solid fa-user-shield" aria-hidden="true"></i> Ask GM: Trait ruling</button>{{#if gmReview}}<span class="ac-muted">GM review needed for situational or triggered clauses.</span>{{/if}}</div><div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Trait</button></div>
          </div></details>
          {{else}}<p class="ac-muted">No Traits recorded.</p>{{/each}}
        </div></article>

        <article class="ac-panel"><header class="ac-panel-title"><span>Specialisations</span><small>{{specialisations.length}}</small></header><div class="ac-record-list compact">
          {{#each specialisations}}
          <details class="ac-disclosure-record"><summary><span class="ac-data-icon"><i class="fa-solid fa-bullseye"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>{{system.skill}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts two"><div><span>Skill</span><strong>{{system.skill}}</strong></div><div><span>Untrained Difficulty</span><strong>{{system.missingDifficulty}}</strong></div></div>
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Specialisation</button></div>
          </div></details>
          {{else}}<p class="ac-muted">No Specialisations recorded.</p>{{/each}}
        </div></article>

        <article class="ac-panel"><header class="ac-panel-title"><span>Baggage</span><small>{{baggage.length}}</small></header><div class="ac-record-list compact">
          {{#each baggage}}
          <details class="ac-disclosure-record"><summary><span class="ac-data-icon"><i class="fa-solid fa-suitcase"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>{{system.appliesTo}}{{#if system.resolved}} · RESOLVED{{/if}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts four"><div><span>Applies To</span><strong>{{system.appliesTo}}</strong></div><div><span>Severity</span><strong>{{system.severity}}</strong></div><div><span>Roll Range</span><strong>{{system.rollMin}}–{{system.rollMax}}</strong></div><div><span>Status</span><strong>{{#if system.resolved}}Resolved{{else}}Active{{/if}}</strong></div></div>
            {{#unless system.resolved}}<div class="ac-record-actions"><button type="button" data-action="resolveBaggage" data-item-id="{{id}}" title="GM only: apply published Personality Frag, Trauma or Compromised DHF consequence"><i class="fa-solid fa-user-doctor" aria-hidden="true"></i> GM: Resolve Baggage</button></div>{{else}}<small class="ac-muted">Resolved: {{system.resolutionChoice}}</small>{{/unless}}<div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Baggage</button></div>
          </div></details>
          {{else}}<p class="ac-muted">No unresolved life-event baggage.</p>{{/each}}
        </div></article>

        <article class="ac-panel"><header class="ac-panel-title"><span>Conditions & Injuries</span><small>ACTIVE STATE</small></header><div class="ac-record-list compact">
          {{#each conditions}}
          <details class="ac-disclosure-record warning"><summary><span class="ac-data-icon"><i class="fa-solid fa-triangle-exclamation"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>Condition · Severity {{system.severity}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts four"><div><span>Category</span><strong>{{system.category}}</strong></div><div><span>Difficulty</span><strong>{{system.difficulty}}</strong></div><div><span>Severity</span><strong>{{system.severity}}</strong></div><div><span>Duration</span><strong>{{system.duration}}</strong></div></div><div class="ac-record-tags">{{#if system.stacking}}<span>Stacks</span>{{/if}}</div>
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Condition</button></div>
          </div></details>
          {{/each}}
          {{#each injuries}}
          <details class="ac-disclosure-record danger"><summary><span class="ac-data-icon"><i class="fa-solid fa-bone"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>Injury ×{{system.count}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts three"><div><span>Count</span><strong>{{system.count}}</strong></div><div><span>Recovery Rate</span><strong>{{system.recoveryRate}}</strong></div><div><span>Status</span><strong>{{#if system.active}}Active{{else}}Recovered{{/if}}</strong></div></div>
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Injury</button></div>
          </div></details>
          {{/each}}
          {{#unless conditions.length}}{{#unless injuries.length}}<p class="ac-muted">No current conditions or injuries.</p>{{/unless}}{{/unless}}
        </div></article>
      </div>

      <article class="ac-panel"><header class="ac-panel-title"><span>Scandals</span><small>{{scandals.length}}</small></header><div class="ac-record-list compact">
        {{#each scandals}}
        <details class="ac-disclosure-record"><summary><span class="ac-data-icon"><i class="fa-solid fa-user-secret"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>Influence loss {{system.influenceLoss}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
          {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts two"><div><span>Influence Loss</span><strong>{{system.influenceLoss}}</strong></div><div><span>Status</span><strong>{{#if system.active}}Active{{else}}Inactive{{/if}}</strong></div></div>
          <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Scandal</button></div>
        </div></details>
        {{else}}<p class="ac-muted">No Scandals recorded.</p>{{/each}}
      </div></article>
    </section>
    {{/if}}

    {{#if isHistory}}
    <section class="ac-page">
      <div class="ac-page-title"><div><span class="ac-kicker">05 // EMBODIMENT HISTORY</span><h1>Sleeve Archive</h1></div><p>Your bodies are chapters, not your identity. Click any archived sleeve to inspect its complete record; edits only appear in Edit Mode.</p></div>
      <article class="ac-panel ac-timeline">
        {{#each archivedSleeves}}
        <details class="ac-timeline-entry ac-disclosure-record">
          <summary><span class="ac-timeline-node"></span><div><small>{{system.acquired}} → {{system.lost}}</small><strong class="ac-record-name">{{name}}</strong><em>{{system.sleeveType}} // {{system.status}}</em></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary>
          <div class="ac-timeline-content ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
            <div class="ac-record-facts four">
              <div><span>Strength</span><strong>{{system.strength}}</strong></div><div><span>Perception</span><strong>{{system.perception}}</strong></div><div><span>Health</span><strong>{{system.healthMax}}</strong></div><div><span>Damage Threshold</span><strong>{{system.damageThreshold}}</strong></div>
              <div><span>Sex</span><strong>{{system.sex}}</strong></div><div><span>Acquired</span><strong>{{system.acquired}}</strong></div><div><span>Lost</span><strong>{{system.lost}}</strong></div><div><span>Loss / Transfer</span><strong>{{system.lossCause}}</strong></div>
            </div>
            {{#if system.appearance}}<div class="ac-record-block"><span>Appearance</span><div>{{{system.appearance}}}</div></div>{{/if}}
            {{#if system.complications}}<div class="ac-record-block"><span>Complications</span><div>{{{system.complications}}}</div></div>{{/if}}
            <div class="ac-record-tags">{{#if system.compulsoryTransfer}}<span>Compulsory Transfer</span>{{/if}}{{#if system.crossSleeved}}<span>Cross-Sleeved</span>{{/if}}{{#if system.preferredBirthClone}}<span>Birth-Sleeve Clone</span>{{/if}}{{#if system.geoRestricted}}<span>GeoRestricted</span>{{/if}}{{#if system.lowQuality}}<span>Low Quality Synthetic</span>{{/if}}</div>
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Sleeve Record</button></div>
          </div>
        </details>
        {{else}}<div class="ac-empty-state"><i class="fa-solid fa-clock-rotate-left"></i><h3>No archived sleeves</h3><p>Previous embodiments appear here after resleeving or when added manually.</p></div>{{/each}}
      </article>
    </section>
    {{/if}}

    {{#if isRelationships}}
    <section class="ac-page">
      <div class="ac-page-title"><div><span class="ac-kicker">06 // SOCIAL GRAPH</span><h1>Relationships & Networks</h1></div><p>People, organisations and trust states use the same read-first record behaviour as the rest of the sheet. Open reveals data; Edit Mode exposes the editor.</p></div>
      <div class="ac-dashboard-grid two">
        <article class="ac-panel"><header class="ac-panel-title"><span>Relationships</span><small>{{relationships.length}} LINKS</small></header><div class="ac-record-list compact">
          {{#each relationships}}
          <details class="ac-disclosure-record ac-relationship-record">
            <summary><div class="ac-rel-sigil">{{system.category}}</div><div><strong class="ac-record-name">{{name}}</strong><small>{{system.revealState}} · {{system.category}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary>
            <div class="ac-record-detail">
              {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
