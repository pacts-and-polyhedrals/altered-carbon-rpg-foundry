<form class="ac-sheet {{actor.type}}" autocomplete="off">
<header class="ac-header"><img src="{{actor.img}}" data-edit="img" alt="{{actor.name}}"><div><input class="name" name="name" value="{{actor.name}}"><div class="subline">{{system.identity.trueName}} · {{system.identity.archetype}} · {{system.identity.variant}}</div></div><div class="stack-state">STACK: {{system.stackState}}</div></header>
<nav class="ac-tabs">
<button type="button" data-action="setTab" data-tab="identity">Identity</button><button type="button" data-action="setTab" data-tab="sleeve">Current Sleeve</button><button type="button" data-action="setTab" data-tab="skills">Skills</button><button type="button" data-action="setTab" data-tab="traits">Traits & State</button><button type="button" data-action="setTab" data-tab="history">Prior Sleeves</button><button type="button" data-action="setTab" data-tab="relationships">Relationships</button><button type="button" data-action="setTab" data-tab="evidence">Evidence</button><button type="button" data-action="setTab" data-tab="gear">Gear</button><button type="button" data-action="setTab" data-tab="combat">Combat</button><button type="button" data-action="openRules">2020 Rules</button>
</nav>
{{#if isIdentity}}
<section class="ac-grid"><section><h2>Identity</h2><label>True DHF <input name="system.identity.trueName" value="{{system.identity.trueName}}"></label><label>Public Name <input name="system.identity.publicName" value="{{system.identity.publicName}}"></label><label>Pronouns <input name="system.identity.pronouns" value="{{system.identity.pronouns}}"></label><label>DHF Age <input type="number" name="system.identity.dhfAge" value="{{system.identity.dhfAge}}"></label><label>Storage Years <input type="number" name="system.identity.storageYears" value="{{system.identity.storageYears}}"></label><label>Archetype <input name="system.identity.archetype" value="{{system.identity.archetype}}"></label><label>Variant <input name="system.identity.variant" value="{{system.identity.variant}}"></label><label>Objective <input name="system.identity.currentObjective" value="{{system.identity.currentObjective}}"></label></section>
<section><h2>Resources</h2><label>Health <input type="number" name="system.resources.health.value" value="{{system.resources.health.value}}"> / {{system.resources.health.max}}</label><label>Wounds <input type="number" name="system.resources.wounds.value" value="{{system.resources.wounds.value}}"> / {{ac.damageThreshold}}</label><label>Ego <input type="number" name="system.resources.ego.value" value="{{system.resources.ego.value}}"> / {{system.resources.ego.max}}</label><label>SP <input type="number" name="system.resources.stackPoints.value" value="{{system.resources.stackPoints.value}}"> <button type="button" data-action="spendSP">Spend</button></label><label>IP <input type="number" name="system.resources.influence.value" value="{{system.resources.influence.value}}"></label><label>Wealth <input type="number" min="0" max="6" name="system.wealth" value="{{system.wealth}}"> (effective {{ac.effectiveWealth}})</label><label>Deferral <input type="number" min="0" max="5" name="system.economy.deferral" value="{{system.economy.deferral}}"></label><label>Debt <input type="checkbox" name="system.economy.debt" {{checked system.economy.debt}}></label></section></section>
<section><h2>Attributes</h2><div class="attributes">{{#each system.attributes as |value key|}}<label><span>{{key}}</span><input type="number" name="system.attributes.{{key}}" value="{{value}}"><b>{{lookup ../ac.bonuses key}}</b></label>{{/each}}</div></section>
<section><h2>Backup</h2><label>Backup active <input type="checkbox" name="system.backup.enabled" {{checked system.backup.enabled}}></label><label>Price Level <input type="number" name="system.backup.priceLevel" value="{{system.backup.priceLevel}}"></label><label>Routinely updated <input type="checkbox" name="system.backup.routine" {{checked system.backup.routine}}></label></section>
{{/if}}
{{#if isSleeve}}<section><h2>Current / Candidate Sleeves</h2>{{#each sleeves}}<article class="item-row"><span><strong>{{name}}</strong><br>{{system.sleeveType}} · {{system.status}} · STR {{system.strength}} PER {{system.perception}} · HP {{system.healthMax}} · DT {{system.strength}} · Q {{system.techUsed}}/{{system.techCapacity}}</span>{{#unless isActive}}<button type="button" data-action="activateSleeve" data-item-id="{{id}}">Activate</button>{{/unless}}<button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button></article>{{/each}}<p>Cargo: {{ac.cargo.used}} / {{ac.cargo.capacity}} {{#if ac.cargo.encumbered}}— Encumbered {{ac.cargo.level}}{{/if}}</p></section>{{/if}}
{{#if isSkills}}<section><h2>Skills</h2><div class="item-list">{{#each skills}}<div class="item-row" data-item-id="{{id}}"><span>{{name}}</span><span>{{system.attribute}} · Lv.{{system.level}} d{{skillDieSides}} · TV +{{system.trainingBonus}}</span><button type="button" data-action="rollSkill" data-item-id="{{id}}">Roll</button><button type="button" data-action="opposedRoll" data-item-id="{{id}}">Opposed</button><button type="button" data-action="editItem" data-item-id="{{id}}">✎</button></div>{{/each}}</div></section>{{/if}}
{{#if isTraits}}<section><h2>Traits</h2>{{#each traits}}<div class="item-row"><span>{{system.tree}} / {{system.branch}} — {{name}} (T{{system.tier}})</span><button type="button" data-action="editItem" data-item-id="{{id}}">Open</button></div>{{/each}}<h2>Specialisations</h2>{{#each specialisations}}<div class="item-row"><span>{{system.skill}} — {{name}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Open</button></div>{{/each}}<h2>Baggage</h2>{{#each baggage}}<div class="item-row"><span>{{name}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Open</button></div>{{/each}}<h2>Conditions & Injuries</h2>{{#each conditions}}<div class="item-row"><span>Condition: {{name}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Open</button></div>{{/each}}{{#each injuries}}<div class="item-row"><span>Injury: {{name}} ×{{system.count}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Open</button></div>{{/each}}<h2>Scandals</h2>{{#each scandals}}<div class="item-row"><span>{{name}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Open</button></div>{{/each}}</section>{{/if}}
{{#if isHistory}}<section><h2>Previous Sleeves</h2>{{#each archivedSleeves}}<details><summary>{{system.acquired}}–{{system.lost}} · {{name}}</summary><div>{{{system.description}}}</div><button type="button" data-action="editItem" data-item-id="{{id}}">Edit dossier</button></details>{{/each}}</section>{{/if}}
{{#if isRelationships}}<section><h2>Relationships</h2>{{#each relationships}}<div class="item-row"><span>{{name}}</span><span>{{system.category}} · {{system.revealState}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button></div>{{/each}}<h2>Networks</h2>{{#each networks}}<div class="item-row"><span>{{name}} · Lv.{{system.level}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button></div>{{/each}}</section>{{/if}}
{{#if isEvidence}}<section><h2>Evidence & Memories</h2>{{#each clues}}<div class="item-row"><span>{{name}}</span><span>{{type}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Open</button></div>{{/each}}</section>{{/if}}
{{#if isGear}}<section><h2>Equipment</h2>{{#each equipment}}<div class="item-row"><span><strong>{{name}}</strong><br>{{type}}{{#if canDeplete}} · Capacity {{system.capacity}} · DP {{system.depletion}}{{#if system.exhausted}} · <strong>EXHAUSTED</strong>{{/if}}{{/if}}</span><span>{{#if canUse}}<button type="button" data-action="useWeapon" data-item-id="{{id}}">Use / Attack</button>{{/if}}{{#if canUseEquipment}}<button type="button" data-action="useEquipment" data-item-id="{{id}}">Use with Skill</button>{{/if}}{{#if canDeplete}}<button type="button" data-action="addDepletion" data-item-id="{{id}}">+DP</button>{{/if}}<button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button></span></div>{{/each}}<p class="muted">Weapon Use rolls the linked Skill, applies Gear/Bonus Dice, then resolves Core Depletion. Damage cards provide GM/owner controls for Wounds, Protection, Ego, sleeve death, stack damage, Real Death, and resleeving state.</p><h2>Resource Catalog</h2>{{#each resources}}<div class="item-row"><span>{{name}} · Price {{system.priceLevel}} · Capacity {{system.capacity}} · DP {{system.depletion}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button></div>{{/each}}</section>{{/if}}
{{#if isCombat}}<section><h2>Combat</h2><button type="button" data-action="openCombat">Open Combat Console</button><p>Speed Dice: <strong>{{ac.speedDice}}d6</strong> · Defense {{system.defense}} · Damage Threshold {{ac.damageThreshold}}</p><p>Intent → Check → Resolution. Uncommitted Speed Dice remain available for Save Throws. Additional check-based actions increase Difficulty cumulatively.</p><h3>State</h3><p>Sleeve: {{system.sleeveState}} · Ego: {{system.egoState}} · Stack: {{system.stackState}}</p></section>{{/if}}
</form>
