            {{#if isArmour}}<div class="ac-record-facts four"><div><span>Defense</span><strong>{{system.defense}}</strong></div><div><span>Protection</span><strong>{{system.protection}}</strong></div><div><span>Damage Types</span><strong>{{system.damageTypes}}</strong></div><div><span>Battle Armor</span><strong>{{#if system.battleArmor}}Yes{{else}}No{{/if}}</strong></div></div>{{/if}}
            {{#if isAugmentation}}<div class="ac-record-facts four"><div><span>Tech Cost</span><strong>{{system.techCost}}</strong></div><div><span>Tech Points</span><strong>{{system.techPoints}}</strong></div><div><span>Powered</span><strong>{{#if system.powered}}Yes{{else}}No{{/if}}</strong></div><div><span>Status</span><strong>{{#if system.active}}Active{{else}}Inactive{{/if}}</strong></div></div>{{/if}}
            {{#if isCreditSet}}<div class="ac-record-facts three"><div><span>Credit Level</span><strong>{{system.value}}</strong></div><div><span>Spent</span><strong>{{system.spent}}</strong></div><div><span>Untraceable</span><strong>{{#if system.untraceable}}Yes{{else}}No{{/if}}</strong></div></div>{{/if}}
            {{#if isVirtualConstruct}}<div class="ac-record-facts four"><div><span>Integrity</span><strong>{{system.integrity}}</strong></div><div><span>Access Level</span><strong>{{system.accessLevel}}</strong></div><div><span>Firewall Class</span><strong>{{system.firewallClass}}</strong></div><div><span>Virus Class</span><strong>{{system.virusClass}}</strong></div></div>{{/if}}
            {{#if isEquipment}}<div class="ac-record-facts four"><div><span>Price</span><strong>{{system.priceLevel}}</strong></div><div><span>Tech</span><strong>{{system.techUsed}} / {{system.techPoints}}</strong></div><div><span>Cargo</span><strong>{{system.cargoUnits}}</strong></div><div><span>Powered</span><strong>{{#if system.powered}}Yes{{else}}No{{/if}}</strong></div></div>{{/if}}
            {{#if isSoftware}}<div class="ac-record-facts four"><div><span>Price</span><strong>{{system.priceLevel}}</strong></div><div><span>Tech Points</span><strong>{{system.techPoints}}</strong></div><div><span>Powered</span><strong>{{#if system.powered}}Yes{{else}}No{{/if}}</strong></div><div><span>Status</span><strong>{{#if system.exhausted}}Exhausted{{else}}Available{{/if}}</strong></div></div>{{/if}}
            {{#if canDeplete}}<div class="ac-record-facts three"><div><span>Capacity</span><strong>{{system.capacity}}</strong></div><div><span>Depletion</span><strong>{{system.depletion}}</strong></div><div><span>Depletion Mode</span><strong>{{system.depletionMode}}</strong></div></div>{{/if}}
            {{#if system.specialRules}}<div class="ac-record-block"><span>Special Rules</span><div>{{system.specialRules}}</div></div>{{/if}}{{#if system.triggeredEffects}}<div class="ac-record-block"><span>Triggered Effects</span><div>{{{system.triggeredEffects}}}</div></div>{{/if}}{{#if system.upgrades}}<div class="ac-record-block"><span>Upgrades</span><div>{{{system.upgrades}}}</div></div>{{/if}}
            <div class="ac-record-actions">{{#if canGearState}}<button type="button" data-action="setGearState" data-item-id="{{id}}" title="Set worn, equipped, carried or stored">State: {{system.equipState}}</button>{{/if}}{{#if canWorkbench}}<button type="button" data-action="openWorkbench" data-item-id="{{id}}">Upgrade Workbench</button>{{/if}}{{#if canUse}}<button type="button" data-action="useWeapon" data-item-id="{{id}}"><i class="fa-solid fa-crosshairs"></i> Use / Attack</button>{{/if}}{{#if canUseEquipment}}<button type="button" data-action="useEquipment" data-item-id="{{id}}"><i class="fa-solid fa-bolt"></i> Use with Skill</button>{{/if}}{{#if canUseDrug}}<button type="button" data-action="useDrug" data-item-id="{{id}}"><i class="fa-solid fa-capsules"></i> Clinical Procedure</button>{{/if}}{{#if canDeplete}}<button type="button" data-action="addDepletion" data-item-id="{{id}}">+DP</button>{{/if}}</div>
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit {{type}}</button></div>
          </div>
        </details>
        {{else}}<p class="ac-muted">No equipment recorded.</p>{{/each}}
      </div></article>

      <article class="ac-panel"><header class="ac-panel-title"><span>Resource Catalog</span><small>{{resources.length}} ENTRIES</small></header><div class="ac-record-list compact">
        {{#each resources}}
        <details class="ac-disclosure-record ac-resource-record"><summary><span class="ac-data-icon"><i class="fa-solid fa-database"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>Price {{system.priceLevel}} · Capacity {{system.capacity}} · DP {{system.depletion}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
          {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts four"><div><span>Item / Service</span><strong>{{system.itemName}}</strong></div><div><span>Price Level</span><strong>{{system.priceLevel}}</strong></div><div><span>Capacity</span><strong>{{system.capacity}}</strong></div><div><span>Depletion</span><strong>{{system.depletion}}</strong></div></div>
          <div class="ac-record-tags">{{#if system.rare}}<span>Rare</span>{{/if}}{{#if system.regulated}}<span>Regulated</span>{{/if}}{{#if system.unregistered}}<span>Unregistered</span>{{/if}}{{#if system.grayMarket}}<span>Gray Market</span>{{/if}}{{#if system.blackMarket}}<span>Black Market / Custom</span>{{/if}}{{#if system.exhausted}}<span>Exhausted</span>{{/if}}</div>
          <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Resource</button></div>
        </div></details>
        {{else}}<p class="ac-muted">No Resource Catalog entries.</p>{{/each}}
      </div></article>
    </section>
    {{/if}}
    {{#if isCombat}}
    <section class="ac-page">
      <div class="ac-page-title"><div><span class="ac-kicker">09 // TACTICAL STATE</span><h1>Combat</h1></div><p>Altered Carbon combat flows through Intent → Check → Resolution. Speed Dice are both timing and action economy.</p></div>
      <div class="ac-combat-hud">
        <div><span>SPEED DICE</span><strong>{{ac.speedDice}}d6</strong><small>Spent / total: <b data-ac-speed-progress="{{actor.id}}" data-ac-speed-suffix="">{{speedStatus.used}}/{{speedStatus.total}}</b>. {{#if speedStatus.submitted}}Locked{{else}}{{#if speedStatus.rolled}}Rolled privately{{else}}Awaiting private roll{{/if}}{{/if}}</small></div>
        <div><span>DEFENSE</span><strong>{{ac.defense}}</strong><small>Includes worn armour (damage-type specific).</small></div>
        <div><span>DAMAGE THRESHOLD</span><strong>{{ac.damageThreshold}}</strong><small>Equal to current Strength.</small></div>
        <div><span>STACK</span><strong>{{system.stackState}}</strong><small>Intact, damaged or destroyed.</small></div>
      </div>
      <article class="ac-panel ac-combat-brief"><header class="ac-panel-title"><span>Turn Procedure</span><small>INTENT // CHECK // RESOLUTION</small></header><p>Uncommitted Speed Dice remain available for Save Throws. Additional check-based actions increase Difficulty cumulatively. Open the tactical console to commit, reveal and resolve Speed Dice.</p>
      <div class="ac-record-facts four"><div><span>Protection</span><strong>{{ac.protection}}</strong></div><div><span>Cover</span><strong>{{cover.label}}</strong></div><div><span>Stance</span><strong>{{stance}}</strong></div><div><span>Pending Wounds</span><strong>{{pendingDamageTotal}} ({{pendingDamageCount}} attacks)</strong></div></div>
      {{#if ac.armour.issues.length}}<p class="ac-danger-text">Armour invalid: {{#each ac.armour.issues}}{{this}} {{/each}}</p>{{/if}}
      <div class="ac-record-actions"><button class="ac-primary-action" type="button" data-action="rollSpeed">{{#if speedStatus.rolled}}Choose / Spend Speed Dice{{else}}Roll Speed Dice Privately{{/if}}</button><button class="ac-primary-action" type="button" data-action="openCombat">Open Combat Console</button><button type="button" data-action="openZones">Zone Assistant</button><button type="button" data-action="setCover">Set Cover</button><button type="button" data-action="setStance">Set Stance</button><button type="button" data-action="openClinical">Medical / Ego / Virtual</button></div>
      {{#if pendingDamageCount}}<p class="ac-callout">Incoming attacks are queued until Resolution, so Protection is applied once across the Turn. Mixed damage types require GM review.</p><div class="ac-record-actions"><button class="ac-primary-action" type="button" data-action="resolveWounds">Resolve {{pendingDamageTotal}} Wounds</button>{{#if isGM}}<button type="button" data-action="clearWounds">Discard Queue (GM)</button>{{/if}}</div>{{/if}}
      </article>
    </section>
    {{/if}}
  </main>
</form>
