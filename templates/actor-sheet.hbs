          <div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
            {{#if isWeapon}}<div class="ac-record-facts four"><div><span>Skill</span><strong>{{system.skill}}</strong></div><div><span>Damage</span><strong>{{system.damage}} {{system.damageType}}</strong></div><div><span>Range</span><strong>{{system.range}}</strong></div><div><span>Complexity</span><strong>{{system.complexity}}</strong></div><div><span>Accuracy</span><strong>{{system.accuracy}}</strong></div><div><span>Deadly</span><strong>{{system.deadly}}</strong></div><div><span>Firing Mode</span><strong>{{system.firingMode}}</strong></div><div><span>Armor Piercing</span><strong>{{#if system.armorPiercing}}Yes{{else}}No{{/if}}</strong></div></div>{{/if}}
            {{#if isAmmunition}}<div class="ac-record-facts four"><div><span>Quantity</span><strong>{{system.quantity}}</strong></div><div><span>Compatible</span><strong>{{system.compatible}}</strong></div><div><span>Damage</span><strong>{{#if system.damageOverride}}{{system.damageOverride}}{{else}}Base weapon{{/if}}{{#if system.damageBonus}} +{{system.damageBonus}}{{/if}}</strong></div><div><span>Type</span><strong>{{system.damageType}}</strong></div><div><span>Armor Piercing</span><strong>{{#if system.armorPiercing}}Yes{{else}}No{{/if}}</strong></div><div><span>Price</span><strong>{{system.priceLevel}}</strong></div></div>{{/if}}
