<form class="ac-sheet ac-shell {{actor.type}} {{#if editMode}}is-editing{{else}}is-viewing{{/if}}" autocomplete="off">
  <header class="ac-hero">
    <div class="ac-portrait-frame">
      <img src="{{actor.img}}" {{#if editMode}}data-edit="img"{{/if}} alt="{{actor.name}}">
      <span class="ac-scan-corner tl"></span><span class="ac-scan-corner tr"></span><span class="ac-scan-corner bl"></span><span class="ac-scan-corner br"></span>
    </div>
    <div class="ac-hero-copy">
      <div class="ac-eyebrow">DIGITAL HUMAN FREIGHT // ACTIVE PROFILE</div>
      <input class="ac-name" name="name" value="{{actor.name}}" aria-label="Actor name">
      <div class="ac-subline">
        <span>{{system.identity.trueName}}</span>
        <span>{{system.identity.archetype}}</span>
        <span>{{system.identity.variant}}</span>
      </div>
    </div>
    <div class="ac-status-cluster">
      <div class="ac-status-chip"><small>STACK</small><strong>{{system.stackState}}</strong></div>
      <div class="ac-status-chip"><small>SLEEVE</small><strong>{{system.sleeveState}}</strong></div>
      <div class="ac-status-chip"><small>EGO</small><strong>{{system.egoState}}</strong></div>
    </div>
  </header>

  <div class="ac-vitals-strip" aria-label="Character vital resources">
    <div class="ac-vital"><span>HEALTH</span><strong>{{system.resources.health.value}} / {{system.resources.health.max}}</strong></div>
    <div class="ac-vital"><span>WOUNDS</span><strong>{{system.resources.wounds.value}} / {{ac.damageThreshold}}</strong></div>
    <div class="ac-vital"><span>EGO</span><strong>{{system.resources.ego.value}} / {{system.resources.ego.max}}</strong></div>
    <div class="ac-vital"><span>SP</span><strong>{{system.resources.stackPoints.value}}</strong></div>
    <div class="ac-vital"><span>IP</span><strong>{{system.resources.influence.value}}</strong></div>
    <div class="ac-vital"><span>WEALTH</span><strong>{{ac.effectiveWealth}}</strong></div>
    <div class="ac-vital"><span>SPEED</span><strong>{{ac.speedDice}}d6</strong></div>
  </div>

  {{#if gmBonusDiceAwards}}
  <details class="ac-assigned-bonuses"><summary><i class="fa-solid fa-dice"></i> GM Bonus Dice assigned (automatic)</summary>
    <p>These dice are added automatically to matching Skill Checks. Do not enter them again in roll options.</p>
    {{#each gmBonusDiceAwards}}<p><strong>{{description}}</strong> / {{label}} / {{scopeLabel}} / {{durationLabel}}</p>{{/each}}
  </details>
  {{/if}}

  <nav class="ac-tabs" aria-label="Character sheet sections">
    <button type="button" data-action="setTab" data-tab="identity" class="{{#if isIdentity}}active{{/if}}"><i class="fa-solid fa-id-card"></i><span>Identity</span></button>
    <button type="button" data-action="setTab" data-tab="sleeve" class="{{#if isSleeve}}active{{/if}}"><i class="fa-solid fa-dna"></i><span>Sleeve</span></button>
    <button type="button" data-action="setTab" data-tab="skills" class="{{#if isSkills}}active{{/if}}"><i class="fa-solid fa-wave-square"></i><span>Skills</span></button>
    <button type="button" data-action="setTab" data-tab="traits" class="{{#if isTraits}}active{{/if}}"><i class="fa-solid fa-diagram-project"></i><span>Traits</span></button>
    <button type="button" data-action="setTab" data-tab="history" class="{{#if isHistory}}active{{/if}}"><i class="fa-solid fa-clock-rotate-left"></i><span>Sleeve Archive</span></button>
    <button type="button" data-action="setTab" data-tab="relationships" class="{{#if isRelationships}}active{{/if}}"><i class="fa-solid fa-share-nodes"></i><span>Networks</span></button>
    <button type="button" data-action="setTab" data-tab="evidence" class="{{#if isEvidence}}active{{/if}}"><i class="fa-solid fa-fingerprint"></i><span>Evidence</span></button>
    <button type="button" data-action="setTab" data-tab="gear" class="{{#if isGear}}active{{/if}}"><i class="fa-solid fa-microchip"></i><span>Gear</span></button>
    <button type="button" data-action="setTab" data-tab="combat" class="{{#if isCombat}}active{{/if}}"><i class="fa-solid fa-crosshairs"></i><span>Combat</span></button>
    {{#if canLevelUp}}<button type="button" data-action="openAdvancement" class="utility"><i class="fa-solid fa-arrow-up-right-dots"></i><span>Level Up</span></button>{{/if}}
    <button type="button" data-action="openRules" class="utility"><i class="fa-solid fa-book-open"></i><span>Rules</span></button>
    <button type="button" data-action="openCoreLibrary" class="utility"><i class="fa-solid fa-boxes-stacked"></i><span>Core Gear</span></button>
    {{#if canEdit}}<button type="button" data-action="toggleEditMode" class="utility ac-edit-mode-toggle {{#if editMode}}active{{/if}}" title="{{#if editMode}}Return to read-only view{{else}}Enable character sheet editing{{/if}}"><i class="fa-solid {{#if editMode}}fa-lock-open{{else}}fa-lock{{/if}}"></i><span>{{#if editMode}}Finish Editing{{else}}Edit Sheet{{/if}}</span></button>{{/if}}
  </nav>

  <main class="ac-sheet-viewport">
    {{#if isIdentity}}
    <section class="ac-page">
      <div class="ac-page-title">
        <div><span class="ac-kicker">01 // IDENTITY CORE</span><h1>DHF Profile</h1></div>
        <p>The DHF is the person. Your sleeve is the body currently carrying that person. Identity, resources and Stack Attributes live here.</p>
      </div>

      <div class="ac-dashboard-grid two">
        <article class="ac-panel">
          <header class="ac-panel-title"><span>DHF Identity</span><small>PERSISTENT</small></header>
          <div class="ac-field-grid two">
            <label><span>True DHF Name <em>The identity that persists across sleeves.</em></span><input name="system.identity.trueName" value="{{system.identity.trueName}}"></label>
            <label><span>Public Name <em>The name people currently know you by.</em></span><input name="system.identity.publicName" value="{{system.identity.publicName}}"></label>
            <label><span>Pronouns <em>Pronouns for the DHF identity.</em></span><input name="system.identity.pronouns" value="{{system.identity.pronouns}}"></label>
            <label><span>DHF Age <em>Total lived age used by several character-creation rules.</em></span><input type="number" name="system.identity.dhfAge" value="{{system.identity.dhfAge}}"></label>
            <label><span>Storage Years <em>Time spent inactive in storage.</em></span><input type="number" name="system.identity.storageYears" value="{{system.identity.storageYears}}"></label>
            <label><span>Archetype <em>Your broad life/career chassis.</em></span><input name="system.identity.archetype" value="{{system.identity.archetype}}"></label>
            <label><span>Variant <em>Standard, AI, Religious Coding, Envoy or Meth.</em></span><input name="system.identity.variant" value="{{system.identity.variant}}"></label>
            <label class="span-two"><span>Current Objective <em>Your immediate personal or operational goal.</em></span><input name="system.identity.currentObjective" value="{{system.identity.currentObjective}}"></label>
          </div>
        </article>

        <article class="ac-panel">
          <header class="ac-panel-title"><span>Operational Resources</span><small>LIVE VALUES</small></header>
          <div class="ac-resource-grid">
            <label><span>Health</span><div><input type="number" name="system.resources.health.value" value="{{system.resources.health.value}}"><b>/ {{system.resources.health.max}}</b></div><small>Sleeve physical integrity.</small></label>
            <label><span>Wounds</span><div><input type="number" name="system.resources.wounds.value" value="{{system.resources.wounds.value}}"><b>/ {{ac.damageThreshold}}</b></div><small>Organic trauma before direct Health loss.</small></label>
            <label><span>Ego</span><div><input type="number" name="system.resources.ego.value" value="{{system.resources.ego.value}}"><b>/ {{system.resources.ego.max}}</b></div><small>Psychological and virtual resilience.</small></label>
            <label><span>Stack Points</span><div><input type="number" name="system.resources.stackPoints.value" value="{{system.resources.stackPoints.value}}"><button type="button" data-action="spendSP">Spend</button></div><small>Long-term growth and resilience resource.</small></label>
            <label><span>Influence</span><div><input type="number" name="system.resources.influence.value" value="{{system.resources.influence.value}}"></div><small>Social leverage and network capital.</small></label>
            <label><span>Wealth</span><div><input type="number" min="0" max="6" name="system.wealth" value="{{system.wealth}}"><b>EFF {{ac.effectiveWealth}}</b></div><small>Abstract purchasing power.</small></label>
            <label><span>Deferral</span><div><input type="number" min="0" max="5" name="system.economy.deferral" value="{{system.economy.deferral}}"></div><small>Temporary pressure on effective Wealth.</small></label>
            <label class="switch-row"><span>Debt</span><input type="checkbox" name="system.economy.debt" {{checked system.economy.debt}}><small>Persistent financial obligation.</small></label>
          </div>
        </article>
      </div>

      <article class="ac-panel ac-attributes-panel">
        <header class="ac-panel-title"><span>Attributes</span><small>SLEEVE + STACK MATRIX</small></header>
        <p class="ac-help-line">Strength and Perception describe the active sleeve. Empathy, Willpower, Acuity and Intelligence describe the persistent DHF. The bonus shown at right is derived automatically.</p>
        <div class="ac-attribute-grid">
          <label class="ac-attribute physical"><span class="code">STR</span><span class="label">Strength<small>Physical power. Also sets Damage Threshold.</small></span><input type="number" name="system.attributes.strength" value="{{system.attributes.strength}}"><b>{{lookup ac.bonuses "strength"}}</b></label>
          <label class="ac-attribute physical"><span class="code">PER</span><span class="label">Perception<small>Sleeve senses. Its bonus drives natural Speed Dice.</small></span><input type="number" name="system.attributes.perception" value="{{system.attributes.perception}}"><b>{{lookup ac.bonuses "perception"}}</b></label>
          <label class="ac-attribute mental"><span class="code">EMP</span><span class="label">Empathy<small>Social and emotional reading of people.</small></span><input type="number" name="system.attributes.empathy" value="{{system.attributes.empathy}}"><b>{{lookup ac.bonuses "empathy"}}</b></label>
          <label class="ac-attribute mental"><span class="code">WIL</span><span class="label">Willpower<small>Mental resistance, resolve and self-control.</small></span><input type="number" name="system.attributes.willpower" value="{{system.attributes.willpower}}"><b>{{lookup ac.bonuses "willpower"}}</b></label>
          <label class="ac-attribute mental"><span class="code">ACU</span><span class="label">Acuity<small>Fast cognitive processing and situational response.</small></span><input type="number" name="system.attributes.acuity" value="{{system.attributes.acuity}}"><b>{{lookup ac.bonuses "acuity"}}</b></label>
          <label class="ac-attribute mental"><span class="code">INT</span><span class="label">Intelligence<small>Reasoning, knowledge and technical understanding.</small></span><input type="number" name="system.attributes.intelligence" value="{{system.attributes.intelligence}}"><b>{{lookup ac.bonuses "intelligence"}}</b></label>
        </div>
      </article>

      <article class="ac-panel">
        <header class="ac-panel-title"><span>DHF Backup</span><small>CONTINUITY INSURANCE</small></header>
        <div class="ac-field-grid three">
          <label class="switch-row"><span>Backup Active <em>Whether a recoverable backup currently exists.</em></span><input type="checkbox" name="system.backup.enabled" {{checked system.backup.enabled}}></label>
          <label><span>Price Level <em>Economic tier of the backup service.</em></span><input type="number" name="system.backup.priceLevel" value="{{system.backup.priceLevel}}"></label>
          <label class="switch-row"><span>Routine Updates <em>Whether the backup is regularly refreshed.</em></span><input type="checkbox" name="system.backup.routine" {{checked system.backup.routine}}></label>
        </div>
      </article>
    </section>
    {{/if}}

    {{#if isSleeve}}
    <section class="ac-page">
      <div class="ac-page-title"><div><span class="ac-kicker">02 // EMBODIMENT</span><h1>Current Sleeve</h1></div><p>Your sleeve is replaceable hardware: physical Attributes, body integrity, appearance and augment capacity belong here.</p></div>
      <article class="ac-panel">
        <header class="ac-panel-title"><span>Sleeve Registry</span><small>{{sleeves.length}} RECORDS</small></header>
        <div class="ac-record-list">
          {{#each sleeves}}
          <details class="ac-disclosure-record ac-sleeve-record {{#if isActive}}active{{/if}}">
            <summary><span class="ac-data-icon"><i class="fa-solid fa-dna"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>{{system.sleeveType}} · {{system.status}} · STR {{system.strength}} · PER {{system.perception}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary>
            <div class="ac-record-detail">
              {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
              <div class="ac-record-facts four">
                <div><span>Status</span><strong>{{system.status}}</strong></div><div><span>Sleeve Type</span><strong>{{system.sleeveType}}</strong></div><div><span>Quality</span><strong>{{system.quality}}</strong></div><div><span>Sex</span><strong>{{system.sex}}</strong></div>
                <div><span>Strength</span><strong>{{system.strength}}</strong></div><div><span>Perception</span><strong>{{system.perception}}</strong></div><div><span>Health</span><strong>{{system.healthMax}}</strong></div><div><span>Damage Threshold</span><strong>{{system.damageThreshold}}</strong></div>
                <div><span>Tech</span><strong>{{system.techUsed}} / {{system.techCapacity}}</strong></div><div><span>Apparent Age</span><strong>{{system.apparentAge}}</strong></div><div><span>Acquired</span><strong>{{system.acquired}}</strong></div><div><span>Acquisition Source</span><strong>{{system.acquisitionSource}}</strong></div>
              </div>
              {{#if system.appearance}}<div class="ac-record-block"><span>Appearance</span><div>{{{system.appearance}}}</div></div>{{/if}}
              {{#if system.complications}}<div class="ac-record-block"><span>Complications</span><div>{{{system.complications}}}</div></div>{{/if}}
              <div class="ac-record-tags">{{#if system.compulsoryTransfer}}<span>Compulsory Transfer</span>{{/if}}{{#if system.crossSleeved}}<span>Cross-Sleeved</span>{{/if}}{{#if system.preferredBirthClone}}<span>Birth-Sleeve Clone</span>{{/if}}{{#if system.geoRestricted}}<span>GeoRestricted</span>{{/if}}{{#if system.lowQuality}}<span>Low Quality Synthetic</span>{{/if}}</div>
              {{#unless isActive}}<div class="ac-record-actions"><button type="button" data-action="activateSleeve" data-item-id="{{id}}"><i class="fa-solid fa-bolt"></i> Activate Sleeve</button></div>{{/unless}}
              <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Sleeve</button></div>
            </div>
          </details>
          {{else}}<div class="ac-empty-state"><i class="fa-solid fa-dna"></i><h3>No sleeve records</h3><p>Add a sleeve Item to this Actor. Character creation is in the Actors tab; it creates a separate new character.</p></div>{{/each}}
        </div>
        <div class="ac-inline-stat"><span>CARGO LOAD</span><strong>{{ac.cargo.used}} / {{ac.cargo.capacity}}</strong>{{#if ac.cargo.encumbered}}<em>ENCUMBERED {{ac.cargo.level}}</em>{{/if}}</div>
      </article>
    </section>
    {{/if}}

    {{#if isSkills}}
    <section class="ac-page">
      <div class="ac-page-title"><div><span class="ac-kicker">03 // CAPABILITY MATRIX</span><h1>Skills</h1></div><p>Skill Level sets the die size. Use Roll directly from a closed Skill row. Click the name or chevron only when you need the description; editing remains in Edit Mode.</p></div>
      <div class="ac-skill-groups">
        {{#each skillGroups}}
        <article class="ac-panel ac-skill-panel">
          <header class="ac-panel-title"><span>{{label}}</span><small>{{code}} // BONUS {{bonus}}</small></header>
          <div class="ac-record-list compact">
            {{#each items}}
            <details class="ac-disclosure-record ac-skill-record" data-item-id="{{id}}">
              <summary><span class="ac-data-icon"><i class="fa-solid fa-wave-square"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>Level {{system.level}} · d{{skillDieSides}} · Training +{{system.trainingBonus}}</small></div><button type="button" class="ac-quick-roll" data-action="rollSkill" data-item-id="{{id}}" title="Roll {{name}}" {{#unless @root.canEdit}}disabled{{/unless}}><i class="fa-solid fa-dice-d20" aria-hidden="true"></i> Roll</button><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary>
              <div class="ac-record-detail">
                <div class="ac-record-actions"><button type="button" data-action="rollSkill" data-item-id="{{id}}"><i class="fa-solid fa-dice-d20"></i> Roll Skill</button><button type="button" data-action="opposedRoll" data-item-id="{{id}}"><i class="fa-solid fa-scale-balanced"></i> Opposed Roll</button></div>
                {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
                <div class="ac-record-facts four"><div><span>Primary Attribute</span><strong>{{system.attribute}}</strong></div><div><span>Level</span><strong>{{system.level}}</strong></div><div><span>Skill Die</span><strong>d{{skillDieSides}}</strong></div><div><span>Training</span><strong>+{{system.trainingBonus}}</strong></div></div>
                {{#if system.specialisations}}<div class="ac-record-block"><span>Specialisations</span><div>{{system.specialisations}}</div></div>{{/if}}
                {{#if system.rulesText}}<div class="ac-record-block"><span>Rules</span><div>{{{system.rulesText}}}</div></div>{{/if}}
                <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Skill</button></div>
              </div>
            </details>
            {{else}}<p class="ac-muted">No skills linked to this Attribute.</p>{{/each}}
          </div>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if isTraits}}
    <section class="ac-page">
      <div class="ac-page-title"><div><span class="ac-kicker">04 // PERSONA MODIFIERS</span><h1>Traits & State</h1></div><p>Every record on this page uses the same disclosure pattern: click the name or Open to read it; editing is only exposed while the whole sheet is in Edit Mode.</p></div>
      <div class="ac-dashboard-grid two">
        <article class="ac-panel"><header class="ac-panel-title"><span>Traits</span><small>{{traits.length}}</small></header><div class="ac-record-list compact">
          {{#each traits}}
          <details class="ac-disclosure-record ac-trait-record"><summary><span class="ac-data-icon"><i class="fa-solid fa-diagram-project"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>{{system.tree}} / {{system.branch}} · Tier {{system.tier}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
            <div class="ac-record-facts four"><div><span>Trait Tree</span><strong>{{system.tree}}</strong></div><div><span>Branch</span><strong>{{system.branch}}</strong></div><div><span>Tier</span><strong>{{system.tier}}</strong></div><div><span>Commonality</span><strong>{{system.commonality}}</strong></div><div><span>SP Cost</span><strong>{{system.spCost}}</strong></div></div>
            {{#if system.effect}}<div class="ac-record-block"><span>Mechanical Effect</span><div>{{{system.effect}}}</div></div>{{/if}}{{#if system.trigger}}<div class="ac-record-block"><span>Trigger / Note</span><div>{{{system.trigger}}}</div></div>{{/if}}
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Trait</button></div>
          </div></details>
          {{else}}<p class="ac-muted">No Traits recorded.</p>{{/each}}
        </div></article>

        <article class="ac-panel"><header class="ac-panel-title"><span>Specialisations</span><small>{{specialisations.length}}</small></header><div class="ac-record-list compact">
          {{#each specialisations}}
          <details class="ac-disclosure-record"><summary><span class="ac-data-icon"><i class="fa-solid fa-bullseye"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>{{system.skill}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts two"><div><span>Skill</span><strong>{{system.skill}}</strong></div><div><span>Untrained Difficulty</span><strong>{{system.missingDifficulty}}</strong></div></div>
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Specialisation</button></div>
          </div></details>
          {{else}}<p class="ac-muted">No Specialisations recorded.</p>{{/each}}
        </div></article>

        <article class="ac-panel"><header class="ac-panel-title"><span>Baggage</span><small>{{baggage.length}}</small></header><div class="ac-record-list compact">
          {{#each baggage}}
          <details class="ac-disclosure-record"><summary><span class="ac-data-icon"><i class="fa-solid fa-suitcase"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>{{system.appliesTo}}{{#if system.resolved}} · RESOLVED{{/if}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts four"><div><span>Applies To</span><strong>{{system.appliesTo}}</strong></div><div><span>Severity</span><strong>{{system.severity}}</strong></div><div><span>Roll Range</span><strong>{{system.rollMin}}–{{system.rollMax}}</strong></div><div><span>Status</span><strong>{{#if system.resolved}}Resolved{{else}}Active{{/if}}</strong></div></div>
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Baggage</button></div>
          </div></details>
          {{else}}<p class="ac-muted">No unresolved life-event baggage.</p>{{/each}}
        </div></article>

        <article class="ac-panel"><header class="ac-panel-title"><span>Conditions & Injuries</span><small>ACTIVE STATE</small></header><div class="ac-record-list compact">
          {{#each conditions}}
          <details class="ac-disclosure-record warning"><summary><span class="ac-data-icon"><i class="fa-solid fa-triangle-exclamation"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>Condition · Severity {{system.severity}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts four"><div><span>Category</span><strong>{{system.category}}</strong></div><div><span>Difficulty</span><strong>{{system.difficulty}}</strong></div><div><span>Severity</span><strong>{{system.severity}}</strong></div><div><span>Duration</span><strong>{{system.duration}}</strong></div></div><div class="ac-record-tags">{{#if system.stacking}}<span>Stacks</span>{{/if}}</div>
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Condition</button></div>
          </div></details>
          {{/each}}
          {{#each injuries}}
          <details class="ac-disclosure-record danger"><summary><span class="ac-data-icon"><i class="fa-solid fa-bone"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>Injury ×{{system.count}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts three"><div><span>Count</span><strong>{{system.count}}</strong></div><div><span>Recovery Rate</span><strong>{{system.recoveryRate}}</strong></div><div><span>Status</span><strong>{{#if system.active}}Active{{else}}Recovered{{/if}}</strong></div></div>
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Injury</button></div>
          </div></details>
          {{/each}}
          {{#unless conditions.length}}{{#unless injuries.length}}<p class="ac-muted">No current conditions or injuries.</p>{{/unless}}{{/unless}}
        </div></article>
      </div>

      <article class="ac-panel"><header class="ac-panel-title"><span>Scandals</span><small>{{scandals.length}}</small></header><div class="ac-record-list compact">
        {{#each scandals}}
        <details class="ac-disclosure-record"><summary><span class="ac-data-icon"><i class="fa-solid fa-user-secret"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>Influence loss {{system.influenceLoss}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
          {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts two"><div><span>Influence Loss</span><strong>{{system.influenceLoss}}</strong></div><div><span>Status</span><strong>{{#if system.active}}Active{{else}}Inactive{{/if}}</strong></div></div>
          <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Scandal</button></div>
        </div></details>
        {{else}}<p class="ac-muted">No Scandals recorded.</p>{{/each}}
      </div></article>
    </section>
    {{/if}}

    {{#if isHistory}}
    <section class="ac-page">
      <div class="ac-page-title"><div><span class="ac-kicker">05 // EMBODIMENT HISTORY</span><h1>Sleeve Archive</h1></div><p>Your bodies are chapters, not your identity. Click any archived sleeve to inspect its complete record; edits only appear in Edit Mode.</p></div>
      <article class="ac-panel ac-timeline">
        {{#each archivedSleeves}}
        <details class="ac-timeline-entry ac-disclosure-record">
          <summary><span class="ac-timeline-node"></span><div><small>{{system.acquired}} → {{system.lost}}</small><strong class="ac-record-name">{{name}}</strong><em>{{system.sleeveType}} // {{system.status}}</em></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary>
          <div class="ac-timeline-content ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
            <div class="ac-record-facts four">
              <div><span>Strength</span><strong>{{system.strength}}</strong></div><div><span>Perception</span><strong>{{system.perception}}</strong></div><div><span>Health</span><strong>{{system.healthMax}}</strong></div><div><span>Damage Threshold</span><strong>{{system.damageThreshold}}</strong></div>
              <div><span>Sex</span><strong>{{system.sex}}</strong></div><div><span>Acquired</span><strong>{{system.acquired}}</strong></div><div><span>Lost</span><strong>{{system.lost}}</strong></div><div><span>Loss / Transfer</span><strong>{{system.lossCause}}</strong></div>
            </div>
            {{#if system.appearance}}<div class="ac-record-block"><span>Appearance</span><div>{{{system.appearance}}}</div></div>{{/if}}
            {{#if system.complications}}<div class="ac-record-block"><span>Complications</span><div>{{{system.complications}}}</div></div>{{/if}}
            <div class="ac-record-tags">{{#if system.compulsoryTransfer}}<span>Compulsory Transfer</span>{{/if}}{{#if system.crossSleeved}}<span>Cross-Sleeved</span>{{/if}}{{#if system.preferredBirthClone}}<span>Birth-Sleeve Clone</span>{{/if}}{{#if system.geoRestricted}}<span>GeoRestricted</span>{{/if}}{{#if system.lowQuality}}<span>Low Quality Synthetic</span>{{/if}}</div>
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Sleeve Record</button></div>
          </div>
        </details>
        {{else}}<div class="ac-empty-state"><i class="fa-solid fa-clock-rotate-left"></i><h3>No archived sleeves</h3><p>Previous embodiments appear here after resleeving or when added manually.</p></div>{{/each}}
      </article>
    </section>
    {{/if}}

    {{#if isRelationships}}
    <section class="ac-page">
      <div class="ac-page-title"><div><span class="ac-kicker">06 // SOCIAL GRAPH</span><h1>Relationships & Networks</h1></div><p>People, organisations and trust states use the same read-first record behaviour as the rest of the sheet. Open reveals data; Edit Mode exposes the editor.</p></div>
      <div class="ac-dashboard-grid two">
        <article class="ac-panel"><header class="ac-panel-title"><span>Relationships</span><small>{{relationships.length}} LINKS</small></header><div class="ac-record-list compact">
          {{#each relationships}}
          <details class="ac-disclosure-record ac-relationship-record">
            <summary><div class="ac-rel-sigil">{{system.category}}</div><div><strong class="ac-record-name">{{name}}</strong><small>{{system.revealState}} · {{system.category}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary>
            <div class="ac-record-detail">
              {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
              <div class="ac-record-facts two"><div><span>Relationship</span><strong>{{system.category}}</strong></div><div><span>Reveal State</span><strong>{{system.revealState}}</strong></div><div><span>Historical Identity</span><strong>{{system.contactHistoricalIdentity}}</strong></div><div><span>Current Alias</span><strong>{{system.currentAlias}}</strong></div></div>
              {{#if system.historicalIncident}}<div class="ac-record-block"><span>Historical Incident</span><div>{{{system.historicalIncident}}}</div></div>{{/if}}
              {{#if system.recognitionClues}}<div class="ac-record-block"><span>Recognition Clues</span><div>{{{system.recognitionClues}}}</div></div>{{/if}}
              {{#if system.evidence}}<div class="ac-record-block"><span>Evidence</span><div>{{{system.evidence}}}</div></div>{{/if}}
              {{#if ../isGM}}{{#if system.presentAgenda}}<div class="ac-record-block gm"><span>GM // Present Agenda</span><div>{{{system.presentAgenda}}}</div></div>{{/if}}{{/if}}
              <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Relationship</button></div>
            </div>
          </details>
          {{else}}<p class="ac-muted">No relationship records.</p>{{/each}}
        </div></article>
        <article class="ac-panel"><header class="ac-panel-title"><span>Networks</span><small>{{networks.length}}</small></header><div class="ac-record-list compact">
          {{#each networks}}
          <details class="ac-disclosure-record ac-network-record">
            <summary><span class="ac-data-icon"><i class="fa-solid fa-share-nodes"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>{{system.organization}} · Request Lv.{{system.level}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary>
            <div class="ac-record-detail">
              {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
              <div class="ac-record-facts two"><div><span>Organisation</span><strong>{{system.organization}}</strong></div><div><span>Request Level</span><strong>{{system.level}}</strong></div><div><span>Request Bonus</span><strong>{{system.requestBonus}}</strong></div><div><span>Status</span><strong>{{#if system.exhausted}}Exhausted{{else}}Available{{/if}}</strong></div></div>
              {{#if system.categories}}<div class="ac-record-block"><span>Categories</span><div>{{system.categories}}</div></div>{{/if}}
              <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Network</button></div>
            </div>
          </details>
          {{else}}<p class="ac-muted">No Networks recorded.</p>{{/each}}
        </div></article>
      </div>
    </section>
    {{/if}}

    {{#if isEvidence}}
    <section class="ac-page">
      <div class="ac-page-title"><div><span class="ac-kicker">07 // MEMORY FORENSICS</span><h1>Evidence & Memories</h1></div><p>Clues and memories are read-first records too. Click the name or Open to inspect the data; the Item editor is only available in Edit Mode.</p></div>
      <article class="ac-panel"><header class="ac-panel-title"><span>Archive</span><small>{{clues.length}} RECORDS</small></header><div class="ac-record-list">
        {{#each clues}}
        <details class="ac-disclosure-record ac-evidence-record">
          <summary><span class="ac-data-icon"><i class="fa-solid fa-fingerprint"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>{{type}}{{#if isClue}} · {{#if system.verified}}VERIFIED{{else}}UNVERIFIED{{/if}}{{/if}}{{#if isMemory}} · {{#if system.recovered}}RECOVERED{{else}}LOCKED{{/if}}{{/if}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary>
          <div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
            {{#if isClue}}<div class="ac-record-facts three"><div><span>Revelation</span><strong>{{system.revelationId}}</strong></div><div><span>Essential</span><strong>{{#if system.essential}}Yes{{else}}No{{/if}}</strong></div><div><span>Verification</span><strong>{{#if system.verified}}Verified{{else}}Unverified{{/if}}</strong></div></div>{{/if}}
            {{#if isMemory}}<div class="ac-record-facts three"><div><span>Year</span><strong>{{system.year}}</strong></div><div><span>Sleeve Reference</span><strong>{{system.sleeveId}}</strong></div><div><span>Status</span><strong>{{#if system.recovered}}Recovered{{else}}Locked{{/if}}</strong></div></div>{{/if}}
            {{#if ../isGM}}{{#if system.secret}}<div class="ac-record-block gm"><span>GM / Private Note</span><div>{{{system.secret}}}</div></div>{{/if}}{{/if}}
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit {{type}}</button></div>
          </div>
        </details>
        {{else}}<div class="ac-empty-state"><i class="fa-solid fa-fingerprint"></i><h3>No evidence stored</h3><p>Clues and Memory Items appear here as the investigation grows.</p></div>{{/each}}
      </div></article>
    </section>
    {{/if}}

    {{#if isGear}}
    <section class="ac-page">
      <div class="ac-page-title"><div><span class="ac-kicker">08 // LOADOUT</span><h1>Gear & Resources</h1></div><div class="ac-page-title-actions"><p>Equipment uses the same disclosure interface as every other record. Weapons can load special ammunition; drugs can be administered directly; Core records retain their source and mechanical data.</p><button type="button" class="ac-primary-action" data-action="openCoreLibrary"><i class="fa-solid fa-boxes-stacked"></i> Open Core Gear Library</button></div></div>
      <article class="ac-panel"><header class="ac-panel-title"><span>Equipment</span><small>{{equipment.length}} ITEMS</small></header><div class="ac-record-list">
        {{#each equipment}}
        <details class="ac-disclosure-record ac-gear-record {{#if isDrug}}ac-drug-record{{/if}} {{#if isAmmunition}}ac-ammo-record{{/if}}">
          <summary><span class="ac-data-icon"><i class="fa-solid {{#if isWeapon}}fa-gun{{else}}{{#if isDrug}}fa-capsules{{else}}{{#if isAmmunition}}fa-bullseye{{else}}fa-microchip{{/if}}{{/if}}{{/if}}"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>{{type}}{{#if isDrug}} · {{system.quantity}} dose(s){{/if}}{{#if isAmmunition}} · x{{system.quantity}}{{/if}}{{#if canDeplete}} · DP {{system.depletion}} / {{system.capacity}}{{/if}}{{#if system.exhausted}} · EXHAUSTED{{/if}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary>
          <div class="ac-record-detail">
            {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}
            {{#if system.rulesRef}}<div class="ac-record-source"><i class="fa-solid fa-book"></i> {{system.rulesRef}}{{#if system.category}} · {{system.category}}{{/if}}</div>{{/if}}
            {{#if isWeapon}}<div class="ac-record-facts four"><div><span>Skill</span><strong>{{#if system.skillCheck}}{{system.skillCheck}}{{else}}{{system.skill}}{{/if}}</strong></div><div><span>Damage</span><strong>{{system.damage}} {{system.damageType}}</strong></div><div><span>Range</span><strong>{{system.range}}</strong></div><div><span>Loaded Ammo</span><strong>{{loadedAmmoName}}</strong></div><div><span>Accuracy</span><strong>{{system.accuracy}}</strong></div><div><span>Deadly</span><strong>{{system.deadly}}</strong></div><div><span>Firing Mode</span><strong>{{system.firingMode}}</strong></div><div><span>Armor Piercing</span><strong>{{#if system.armorPiercing}}Yes{{else}}No{{/if}}</strong></div><div><span>Price</span><strong>{{system.priceLevel}}</strong></div><div><span>Tech</span><strong>{{system.techUsed}} / {{system.techPoints}}</strong></div></div>{{/if}}
            {{#if isArmour}}<div class="ac-record-facts four"><div><span>Defense</span><strong>{{system.defense}}</strong></div><div><span>Protection</span><strong>{{system.protection}}</strong></div><div><span>Damage Types</span><strong>{{system.damageTypes}}</strong></div><div><span>Battle Armor</span><strong>{{#if system.battleArmor}}Yes{{else}}No{{/if}}</strong></div><div><span>Price</span><strong>{{system.priceLevel}}</strong></div><div><span>Tech</span><strong>{{system.techUsed}} / {{system.techPoints}}</strong></div></div>{{/if}}
            {{#if isAugmentation}}<div class="ac-record-facts four"><div><span>Tech Cost</span><strong>{{system.techCost}}</strong></div><div><span>Price</span><strong>{{system.priceLevel}}</strong></div><div><span>Ego Cost</span><strong>{{system.egoCost}}</strong></div><div><span>Status</span><strong>{{#if system.active}}Active{{else}}Inactive{{/if}}</strong></div></div>{{#if system.attributeEffects}}<div class="ac-record-block"><span>Attribute Effects</span><div>{{system.attributeEffects}}</div></div>{{/if}}{{#if system.prerequisites}}<div class="ac-record-block"><span>Prerequisites</span><div>{{system.prerequisites}}</div></div>{{/if}}{{/if}}
            {{#if isAmmunition}}<div class="ac-record-facts four"><div><span>Compatibility</span><strong>{{system.compatibleWith}}</strong></div><div><span>Price</span><strong>{{system.priceLevel}}</strong></div><div><span>Damage</span><strong>{{#if system.damage}}{{system.damage}}{{else}}Weapon / special{{/if}} {{system.damageType}}</strong></div><div><span>Quantity</span><strong>{{system.quantity}}</strong></div><div><span>Armor Piercing</span><strong>{{#if system.armorPiercing}}Yes{{else}}No{{/if}}</strong></div><div><span>Deadly</span><strong>{{system.deadly}}</strong></div></div>{{#if system.effect}}<div class="ac-record-block"><span>Ammunition Effect</span><div>{{{system.effect}}}</div></div>{{/if}}{{#if system.requiresUpgrade}}<div class="ac-record-block"><span>Required Weapon Configuration</span><div>{{system.requiresUpgrade}}</div></div>{{/if}}{{/if}}
            {{#if isDrug}}<div class="ac-record-facts four"><div><span>Administration</span><strong>{{system.administration}}</strong></div><div><span>Price</span><strong>{{system.priceLevel}}</strong></div><div><span>Addiction</span><strong>{{#if system.addiction}}Yes{{else}}No{{/if}}</strong></div><div><span>Quantity</span><strong>{{system.quantity}}</strong></div><div><span>Controlled By</span><strong>{{system.controlledBy}} {{system.controlledTier}}</strong></div><div><span>Metabolism</span><strong>{{system.metabolism}}</strong></div></div>{{#if system.effects}}<div class="ac-record-block"><span>Effects</span><div>{{{system.effects}}}</div></div>{{/if}}{{#if system.underInfluence}}<div class="ac-record-block"><span>Under the Influence</span><div>{{{system.underInfluence}}}</div></div>{{/if}}{{#if system.duration}}<div class="ac-record-block"><span>Duration</span><div>{{system.duration}}</div></div>{{/if}}{{/if}}
            {{#if isCreditSet}}<div class="ac-record-facts three"><div><span>Credit Level</span><strong>{{system.value}}</strong></div><div><span>Spent</span><strong>{{system.spent}}</strong></div><div><span>Untraceable</span><strong>{{#if system.untraceable}}Yes{{else}}No{{/if}}</strong></div></div>{{/if}}
            {{#if isVirtualConstruct}}<div class="ac-record-facts four"><div><span>Integrity</span><strong>{{system.integrity}}</strong></div><div><span>Access Level</span><strong>{{system.accessLevel}}</strong></div><div><span>Firewall Class</span><strong>{{system.firewallClass}}</strong></div><div><span>Virus Class</span><strong>{{system.virusClass}}</strong></div></div>{{/if}}
            {{#if isEquipment}}<div class="ac-record-facts four"><div><span>Price</span><strong>{{system.priceLevel}}</strong></div><div><span>Tech</span><strong>{{system.techUsed}} / {{system.techPoints}}</strong></div><div><span>Skill Check</span><strong>{{system.skillCheck}}</strong></div><div><span>Powered</span><strong>{{#if system.powered}}Yes{{else}}No{{/if}}</strong></div></div>{{/if}}
            {{#if isSoftware}}<div class="ac-record-facts four"><div><span>Price</span><strong>{{system.priceLevel}}</strong></div><div><span>Tech</span><strong>{{system.techUsed}} / {{system.techPoints}}</strong></div><div><span>Skill Check</span><strong>{{system.skillCheck}}</strong></div><div><span>Status</span><strong>{{#if system.exhausted}}Exhausted{{else}}Available{{/if}}</strong></div></div>{{/if}}
            {{#if canDeplete}}<div class="ac-record-facts three"><div><span>Capacity</span><strong>{{system.capacity}}</strong></div><div><span>Depletion</span><strong>{{system.depletion}}</strong></div><div><span>Depletion Mode</span><strong>{{system.depletionMode}}</strong></div></div>{{/if}}
            <div class="ac-record-tags">{{#if system.rare}}<span>Rare</span>{{/if}}{{#if system.requisition}}<span>Requisition: {{system.requisition}}</span>{{/if}}{{#if system.standardIssue}}<span>Standard Issue: {{system.standardIssue}}</span>{{/if}}{{#if system.powered}}<span>Powered</span>{{/if}}</div>
            {{#if system.specialRules}}<div class="ac-record-block"><span>Special Rules</span><div>{{system.specialRules}}</div></div>{{/if}}{{#if system.triggeredEffects}}<div class="ac-record-block"><span>Triggered Effects</span><div>{{{system.triggeredEffects}}}</div></div>{{/if}}{{#if system.upgrades}}<div class="ac-record-block"><span>Upgrades</span><div>{{{system.upgrades}}}</div></div>{{/if}}
            <div class="ac-record-actions">{{#if canUse}}<button type="button" data-action="useWeapon" data-item-id="{{id}}"><i class="fa-solid fa-crosshairs"></i> Use / Attack</button>{{/if}}{{#if canLoadAmmo}}<button type="button" data-action="loadAmmo" data-item-id="{{id}}"><i class="fa-solid fa-bullseye"></i> Load Ammo</button>{{/if}}{{#if canUseEquipment}}<button type="button" data-action="useEquipment" data-item-id="{{id}}"><i class="fa-solid fa-bolt"></i> Use with Skill</button>{{/if}}{{#if canUseDrug}}<button type="button" data-action="useDrug" data-item-id="{{id}}"><i class="fa-solid fa-capsules"></i> Administer</button>{{/if}}{{#if canDeplete}}<button type="button" data-action="addDepletion" data-item-id="{{id}}">+DP</button>{{/if}}</div>
            <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit {{type}}</button></div>
          </div>
        </details>
        {{else}}<div class="ac-empty-state"><i class="fa-solid fa-box-open"></i><h3>No equipment recorded</h3><p>Use Core Gear to add official 2020 equipment, drugs, ammunition and augmentations.</p></div>{{/each}}
      </div></article>

      <article class="ac-panel"><header class="ac-panel-title"><span>Resource Catalog</span><small>{{resources.length}} ENTRIES</small></header><div class="ac-record-list compact">
        {{#each resources}}
        <details class="ac-disclosure-record ac-resource-record"><summary><span class="ac-data-icon"><i class="fa-solid fa-database"></i></span><div><strong class="ac-record-name">{{name}}</strong><small>Price {{system.priceLevel}} · Capacity {{system.capacity}} · DP {{system.depletion}}</small></div><span class="ac-open-label">Open</span><i class="fa-solid fa-chevron-down ac-disclosure-chevron"></i></summary><div class="ac-record-detail">
          {{#if system.description}}<div class="ac-record-description">{{{system.description}}}</div>{{/if}}<div class="ac-record-facts four"><div><span>Item / Service</span><strong>{{system.itemName}}</strong></div><div><span>Price Level</span><strong>{{system.priceLevel}}</strong></div><div><span>Capacity</span><strong>{{system.capacity}}</strong></div><div><span>Depletion</span><strong>{{system.depletion}}</strong></div></div>
          <div class="ac-record-tags">{{#if system.rare}}<span>Rare</span>{{/if}}{{#if system.regulated}}<span>Regulated</span>{{/if}}{{#if system.unregistered}}<span>Unregistered</span>{{/if}}{{#if system.grayMarket}}<span>Gray Market</span>{{/if}}{{#if system.blackMarket}}<span>Black Market / Custom</span>{{/if}}{{#if system.exhausted}}<span>Exhausted</span>{{/if}}</div>
          <div class="ac-edit-only-actions"><button type="button" data-action="editItem" data-item-id="{{id}}"><i class="fa-solid fa-pen"></i> Edit Resource</button></div>
        </div></details>
        {{else}}<p class="ac-muted">No Resource Catalog entries.</p>{{/each}}
      </div></article>
    </section>
    {{/if}}
    {{#if isCombat}}
    <section class="ac-page">
      <div class="ac-page-title"><div><span class="ac-kicker">09 // TACTICAL STATE</span><h1>Combat</h1></div><p>Altered Carbon combat flows through Intent → Check → Resolution. Speed Dice are both timing and action economy.</p></div>
      <div class="ac-combat-hud">
        <div><span>SPEED DICE</span><strong>{{ac.speedDice}}d6</strong><small>Natural count from Perception, modified by state.</small></div>
        <div><span>DEFENSE</span><strong>{{system.defense}}</strong><small>Current defensive modifier.</small></div>
        <div><span>DAMAGE THRESHOLD</span><strong>{{ac.damageThreshold}}</strong><small>Equal to current Strength.</small></div>
        <div><span>STACK</span><strong>{{system.stackState}}</strong><small>Intact, damaged or destroyed.</small></div>
      </div>
      <article class="ac-panel ac-combat-brief"><header class="ac-panel-title"><span>Turn Procedure</span><small>INTENT // CHECK // RESOLUTION</small></header><p>Uncommitted Speed Dice remain available for Save Throws. Additional check-based actions increase Difficulty cumulatively. Open the tactical console to commit, reveal and resolve Speed Dice.</p><button class="ac-primary-action" type="button" data-action="openCombat"><i class="fa-solid fa-crosshairs"></i> Open Combat Console</button></article>
    </section>
    {{/if}}
  </main>
</form>
