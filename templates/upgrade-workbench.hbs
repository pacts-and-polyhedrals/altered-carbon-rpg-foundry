<section class="ac-workflow-app ac-shell"><div class="ac-page-title"><div><span class="ac-kicker">EQUIPMENT DEVELOPMENT // 2020 CORE</span><h1>Upgrade Workbench</h1></div><p>Tech Points, Upgrade Kits, install checks, Attachments, Hardwired items and respecs. GM authorizes narrative exceptions and model variants.</p></div>
{{#unless hasActor}}<p class="ac-muted">Open the workbench from an Actor sheet.</p>{{else}}
<header class="ac-panel-title"><span>{{actor}}</span><small>AVAILABLE GEAR</small></header>
<div class="ac-upgrade-grid"><div class="ac-upgrade-sidebar">{{#each items}}<button type="button" data-action="select" data-item-id="{{id}}" {{#if selected}}class="active"{{/if}}>{{name}}</button>{{else}}<p class="ac-muted">No modifiable gear.</p>{{/each}}</div>
<div class="ac-upgrade-main">{{#if selected}}<article class="ac-panel"><header class="ac-panel-title"><span>{{selected.name}}</span><small>{{selected.type}}</small></header><div class="ac-record-facts three"><div><span>Tech Points (Q)</span><strong>{{selected.techUsed}} / {{selected.techPoints}}</strong></div><div><span>Original Q</span><strong>{{selected.baseTechPoints}}</strong></div><div><span>Capacity (base)</span><strong>{{selected.capacity}}</strong></div></div><div class="ac-record-actions">{{#if canEdit}}<button type="button" data-action="install">Install Upgrade</button>{{#if isGM}}<button type="button" data-action="awardKit">GM Award Kit</button><button type="button" data-action="chassis">Chassis Q</button>{{/if}}{{/if}}</div></article>
<article class="ac-panel"><header class="ac-panel-title"><span>Installed Upgrades</span><small>{{installed.length}}</small></header>{{#each installed}}<div class="ac-workflow-row"><div><strong>{{name}}</strong><small>Q{{techCost}}{{#if attachment}} · Attachment{{/if}}{{#if modelVariant}} · Model Variant{{/if}}{{#if hardwired}} · Hardwired{{/if}}{{#if linkedTo}} · Linked{{/if}}</small>{{#if notes}}<small>{{notes}}</small>{{/if}}</div>{{#if ../canEdit}}<button type="button" data-action="respec" data-upgrade-index="{{index}}" {{#if hardwired}}disabled title="Hardwired upgrades cannot be removed"{{/if}}>Respec</button>{{/if}}</div>{{else}}<p class="ac-muted">No upgrades installed.</p>{{/each}}</article>
<article class="ac-panel"><header class="ac-panel-title"><span>Available Source Options</span></header>{{#each upgrades}}<small class="ac-workflow-choice">{{this}}</small>{{/each}}{{#if selected.sourceRules}}<p class="ac-help-line">{{selected.sourceRules}}</p>{{/if}}</article>{{/if}}</div></div>
<p class="ac-help-line">The workbench never invents mechanics for a descriptive upgrade: installed entries are recorded, and only implemented deterministic effects run automatically. Attachments require Short Rest; standard installations consume designated Upgrade Kits.</p>
{{/unless}}</section>
