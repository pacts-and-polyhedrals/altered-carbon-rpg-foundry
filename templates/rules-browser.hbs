<section class="ac-rules-browser ac-shell">
<header><div class="ac-kicker">REFERENCE NODE // 2020 CORE</div><h1>Mechanics Browser</h1><p class="muted">Structured from the supplied 2020 Core Rulebook. Where a Quick Start value differs, the 2020 Core entry is authoritative in this build.</p>{{#if actor}}<p>Target Actor: <strong>{{actor.name}}</strong></p>{{/if}}</header>
<details open><summary><strong>Core check, resource & advancement rules</strong></summary><div class="reference-grid"><div><h3>Skill Levels</h3>{{#each mechanics.skillLevels}}<p>Level {{level}}: d{{die}} · auto-pass TR {{autoPassTR}}</p>{{/each}}</div><div><h3>Advancement</h3><pre>{{json mechanics.skillAdvancement}}</pre></div><div><h3>Trait Costs</h3><pre>{{json mechanics.traitCosts}}</pre></div></div><pre>{{json mechanics.characterResources}}</pre></details>
<details><summary><strong>32 Skills — complete skill-specific rules</strong></summary>{{#each skills}}<article class="rule-entry"><h3>{{name}} — {{attribute}}</h3><p>{{rulesRef}}</p><div class="rules-text">{{{rulesText}}}</div></article>{{/each}}</details>
<details><summary><strong>Traits ({{traits.length}} mechanical records)</strong></summary>{{#each traits}}<article class="rule-entry"><h3>{{tree}} / {{branch}} — {{name}} (Tier {{tier}})</h3><p>{{effect}}</p><button type="button" data-action="add" data-type="trait" data-id="{{id}}">Add to Actor</button></article>{{/each}}</details>
<details><summary><strong>Baggage (complete table)</strong></summary>{{#each baggage}}<article class="rule-entry"><h3>{{min}}–{{max}}: {{name}}</h3><p>{{effect}}</p><button type="button" data-action="add" data-type="baggage" data-id="{{id}}">Add to Actor</button></article>{{/each}}</details>
<details><summary><strong>Status Effects</strong></summary>{{#each conditions}}<article class="rule-entry"><h3>{{name}}</h3><p>{{effect}}</p><button type="button" data-action="add" data-type="condition" data-id="{{id}}">Add to Actor</button></article>{{/each}}</details>
<details><summary><strong>Injuries, Dying & Organic Damage</strong></summary>{{#each injuries}}<article class="rule-entry"><h3>{{name}}</h3><p>{{effect}}</p><button type="button" data-action="add" data-type="injury" data-id="{{id}}">Add to Actor</button></article>{{/each}}<pre>{{json mechanics.damageAndDying}}</pre></details>
<details><summary><strong>Ego, Viruses & Psychosurgery</strong></summary><pre>{{json mechanics.ego}}</pre><pre>{{json mechanics.viralClasses}}</pre></details>
<details><summary><strong>Gear / Universal Equipment Rules</strong></summary>{{#each gearRules}}<article class="rule-entry"><h3>{{name}}</h3><p>{{effect}}</p></article>{{/each}}</details>
<details open><summary><strong>Official Core Item Library — {{itemCatalogCount}} usable Item records</strong></summary><p class="muted">Canonical 2020 Core equipment converted into typed Foundry Items. Open this browser from a character sheet to add records without retyping them.</p>{{#if isGM}}<p><button type="button" data-action="installCatalog"><i class="fa-solid fa-box-archive"></i> Install / Refresh 95-Item World Library</button></p>{{/if}}{{#each itemGroups}}<section class="ac-catalog-group"><h2>{{name}}</h2><div class="reference-grid">{{#each records}}<article class="rule-entry ac-catalog-item"><h3>{{name}}</h3><p><strong>{{type}}</strong> · Core p.{{bookPage}}{{#if system.priceLevel}} · Price {{system.priceLevel}}{{/if}}{{#if system.techPoints}} · Q {{system.techPoints}}{{/if}}</p>{{#if system.damage}}<p>Damage: {{system.damage}} {{system.damageType}}</p>{{/if}}{{#if system.damageOverride}}<p>Damage: {{system.damageOverride}} {{system.damageType}}</p>{{/if}}{{#if system.capacity}}<p>Capacity {{system.capacity}}{{#if system.depletionMode}} · {{system.depletionMode}}{{/if}}</p>{{/if}}{{#if system.specialRules}}<p>{{system.specialRules}}</p>{{/if}}<button type="button" data-action="add" data-type="catalog-item" data-id="{{id}}">Add to Actor</button></article>{{/each}}</div></section>{{/each}}</details>
<details><summary><strong>Generic Weapon Upgrade Catalog ({{upgradeCatalog.length}})</strong></summary>{{#each upgradeCatalog}}<article class="rule-entry"><h3>{{name}} (Q{{techCost}})</h3><p>{{effect}}</p><small>Core p.{{bookPage}}</small></article>{{/each}}</details>
<details><summary><strong>Official Example Vehicles</strong></summary><div class="reference-grid">{{#each vehicleCatalog}}<article class="rule-entry"><h3>{{name}}</h3><p>Core p.{{bookPage}} · Size {{system.vehicle.size}} · Durability {{system.vehicle.durability}} · Structure {{system.vehicle.structure.max}} · Speed {{system.vehicle.speedDice}}d6 · Handling {{system.vehicle.handling}}</p>{{#if ../isGM}}<button type="button" data-action="createVehicle" data-id="{{id}}">Create Vehicle Actor</button>{{/if}}</article>{{/each}}</div></details>
<details><summary><strong>Quick Start legacy / secondary-only records</strong></summary>{{#each legacyCatalog}}<article class="rule-entry"><h3>{{name}}</h3><p>{{reason}}</p><small>{{status}}</small></article>{{/each}}</details>
{{#if hasEquipmentReference}}<details><summary><strong>Complete Chapter 6 item-specific mechanics (private source-backed reference)</strong></summary><p class="muted">Weapons, special ammunition, apparel, devices, software, drugs, vehicles, sleeves and sleeve augments. This optional reference is intended only for a private/local build where the owner has supplied the source material.</p>{{#each equipmentReference}}<details class="source-page"><summary>Book p.{{bookPage}} — {{title}}</summary><pre>{{text}}</pre></details>{{/each}}</details>{{/if}}
<details><summary><strong>Wealth, Credits, Resource Catalogs & Tech Points</strong></summary><pre>{{json mechanics.economy}}</pre><pre>{{json mechanics.techPoints}}</pre></details>
<details><summary><strong>Requests, Networks & Contacts</strong></summary><pre>{{json mechanics.requests}}</pre></details>
<details><summary><strong>Resleeving, Missleeving & Character Variants</strong></summary><pre>{{json mechanics.resleeving}}</pre><pre>{{json mechanics.variants}}</pre></details>
{{#if hasSleeveReference}}<details><summary><strong>Complete Sleeve / Synthetic Feature / Missleeving reference</strong></summary><p class="muted">Optional private/local source-backed Chapter 2 reference covering sleeve attributes, synthetic features, cross-sleeving, downgrades and double-sleeving.</p>{{#each sleeveReference}}<details class="source-page"><summary>Book p.{{bookPage}} — {{title}}</summary><pre>{{text}}</pre></details>{{/each}}</details>{{/if}}
<details><summary><strong>Virtual</strong></summary><pre>{{json mechanics.virtual}}</pre></details>
<details><summary><strong>Vehicles</strong></summary><pre>{{json mechanics.vehicle}}</pre></details>
<details><summary><strong>Scandals</strong></summary>{{#each scandals}}<article class="rule-entry"><h3>{{name}}</h3><p>{{effect}}</p><button type="button" data-action="add" data-type="scandal" data-id="{{id}}">Add to Actor</button></article>{{/each}}</details>
<details><summary><strong>Adversaries, Minions, Nemeses & DHF Backups</strong></summary><pre>{{json mechanics.adversaries}}</pre><pre>{{json mechanics.backup}}</pre></details>
<details><summary><strong>Campaign Progress & Rewards</strong></summary><pre>{{json mechanics.campaign}}</pre></details>
{{#if hasGMReference}}<details><summary><strong>Complete Chapter 7 GM mechanical reference (private source-backed reference)</strong></summary><p class="muted">Optional private/local source-backed reference for campaign generation, Contact creation, Requests, Virtual, adversaries and Scandals.</p>{{#each gmReference}}<details class="source-page"><summary>Book p.{{bookPage}} — {{title}}</summary><pre>{{text}}</pre></details>{{/each}}</details>{{/if}}
</section>
