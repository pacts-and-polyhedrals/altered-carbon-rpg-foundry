<section class="ac-combat-console">{{#unless combat}}<p>No active Combat exists. Create one from Foundry's combat tracker, then reopen this console.</p>{{else}}<header><h2>Turn {{state.turn}} · Round {{state.round}} · {{state.phase}}</h2>{{#if gm}}<div class="ac-controls"><button type="button" data-action="beginIntent">New Intent</button><button type="button" data-action="reveal">Reveal Commitments</button><button type="button" data-action="advance">Begin Check</button><button type="button" data-action="resolution">Resolution</button><button type="button" data-action="next">Next Active</button></div>{{/if}}</header>{{#each combatants}}<section class="ac-combatant {{#if isCurrent}}current{{/if}}"><h3>{{name}} {{#if submitted}}✓ locked{{/if}}</h3><div class="speed-dice">{{#each results}}<label class="speed-die {{#if active}}active{{/if}} {{#if spent}}spent{{/if}}"><input type="checkbox" data-speed-for="{{../id}}" value="{{index}}" {{#if spent}}disabled{{/if}}> d6: <strong>{{result}}</strong>{{#if active}} A{{/if}}{{#if spent}} spent{{/if}}</label>{{/each}}</div>{{#if owned}}<button type="button" data-action="submit" data-combatant-id="{{id}}">Lock Active Dice</button>{{/if}}{{#if ../gm}}{{#each results}}{{#if active}}{{#unless spent}}<button type="button" data-action="spendDie" data-combatant-id="{{../id}}" data-index="{{index}}">Resolve die {{result}}</button>{{/unless}}{{/if}}{{/each}}{{/if}}</section>{{/each}}{{/unless}}</section>
