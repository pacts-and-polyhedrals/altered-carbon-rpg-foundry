<section class="ac-combat-console ac-shell">
  {{#unless combat}}
  <div class="ac-empty-state"><i class="fa-solid fa-crosshairs"></i><h3>No active Combat</h3><p>Create a Combat from Foundry's combat tracker, then reopen the Altered Carbon tactical console.</p></div>
  {{else}}
  <header>
    <div class="ac-kicker">TACTICAL RESOLUTION NODE</div>
    <h2>Turn {{state.turn}} · Round {{state.round}} · {{state.phase}}</h2>
    {{#if gm}}<div class="ac-controls"><button type="button" data-action="beginIntent">New Intent</button><button type="button" data-action="reveal">Reveal Commitments</button><button type="button" data-action="advance">Begin Check</button><button type="button" data-action="resolution">Resolution</button><button type="button" data-action="next">Next Active</button></div>{{/if}}
  </header>
  {{#each combatants}}
  <section class="ac-combatant {{#if isCurrent}}current{{/if}}">
    <h3>{{name}} {{#if submitted}}<span class="ac-kicker"> // LOCKED</span>{{/if}}</h3>
    <div class="speed-dice">
      {{#each results}}
      <label class="speed-die {{#if active}}active{{/if}} {{#if spent}}spent{{/if}}"><input type="checkbox" data-speed-for="{{../id}}" value="{{index}}" {{#if spent}}disabled{{/if}}> d6 <strong>{{result}}</strong>{{#if active}} · ACTIVE{{/if}}{{#if spent}} · SPENT{{/if}}</label>
      {{/each}}
    </div>
    {{#if owned}}<button type="button" data-action="submit" data-combatant-id="{{id}}">Lock Active Dice</button>{{/if}}
    {{#if ../gm}}{{#each results}}{{#if active}}{{#unless spent}}<button type="button" data-action="spendDie" data-combatant-id="{{../id}}" data-index="{{index}}">Resolve {{result}}</button>{{/unless}}{{/if}}{{/each}}{{/if}}
  </section>
  {{/each}}
  {{/unless}}
</section>
